# Шаблон налаштувань. Скопіюй у .env і заповни.
# Цей файл можна комітити — тут немає справжніх значень.

# Токен бота від @BotFather
BOT_TOKEN=

# Ключ Gemini API з Google AI Studio
GEMINI_API_KEY=

# Модель (можна змінити без правки коду)
GEMINI_MODEL=gemini-3.5-flash-lite

# ID адмін-групи з темами (дізнатися: напиши /chatid у групі). Порожньо → передача адміну лише телефоном
ADMIN_CHAT_ID=

# Файл бази даних (необов'язково)
# DB_PATH=storage/bot.db

# Ліміти AI-відповідей (необов'язково; за замовчуванням 20 і 300).
# Кнопки меню і передача адміну працюють без лімітів.
# AI_LIMIT_USER_HOUR=20
# AI_LIMIT_GLOBAL_DAY=300

# Демо-режим (необов'язково): посилання на відео адмін-сторони і контакт розробника для /demo
# DEMO_VIDEO_URL=https://...
# DEVELOPER_CONTACT=@username
